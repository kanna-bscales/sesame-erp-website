# Copy this file to .env.local, fill it in, then restart the dev server (npm run dev).
# .env.local is git-ignored, so credentials never leave this computer.

# ---------------------------------------------------------------------
# OPTION 1 (simplest): send through a Gmail account
# ---------------------------------------------------------------------
# 1. Turn on 2-Step Verification for that Google account:
#    https://myaccount.google.com/signinoptions/twosv
# 2. Create an App password (16 letters):
#    https://myaccount.google.com/apppasswords
# 3. Paste both values below. Spaces in the app password are fine.
SMTP_USER=your.address@gmail.com
SMTP_PASSWORD=your 16 letter app password

# Who receives the enquiries. Use your own address while testing,
# then change it to hi@sesamelabs.ai.
CONTACT_TO=your.address@gmail.com

# Optional, the defaults suit Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# CONTACT_FROM=SesameERP website <your.address@gmail.com>

# ---------------------------------------------------------------------
# OPTION 2: Resend instead of SMTP (only used when SMTP_USER is empty)
# ---------------------------------------------------------------------
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------
# PLMA 2026 attendee lookup and enquiry updates (Zoho CRM API, server only)
# ---------------------------------------------------------------------
# Used by /api/plma/attendee and /api/plma/enquiry. Never prefix these with NEXT_PUBLIC_.
# 1. https://api-console.zoho.com -> Add Client -> Self Client.
# 2. Generate Code with scope:
#    ZohoCRM.modules.leads.ALL,ZohoCRM.modules.campaigns.READ,ZohoCRM.modules.campaigns.UPDATE,ZohoCRM.modules.notes.CREATE,ZohoCRM.coql.READ
# 3. Exchange the code for a refresh token (POST https://accounts.zoho.com/oauth/v2/token
#    with grant_type=authorization_code) and paste the three values below.
# Without them the landing page still works: no prefill, and the form posts to the Zoho webform.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Defaults suit a zoho.com (US) account:
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
# ZOHO_API_DOMAIN=https://www.zohoapis.com
# ZOHO_PLMA_CAMPAIGN_ID=7671386000000694366
